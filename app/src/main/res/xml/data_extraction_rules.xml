<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude everything from cloud backup and device-to-device transfer.
    Copying screen time settings (including the PIN hash) to another phone
    would let someone move or reset limits outside the app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
