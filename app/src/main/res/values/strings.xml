<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Screen time</string>
    <string name="navigate_back">Back</string>

    <!-- Welcome -->
    <string name="welcome_title">Welcome to Screen time</string>
    <string name="welcome_subtitle">See how you use your phone, and set limits that stick.</string>
    <string name="welcome_feature_usage">See how much time you spend in each app</string>
    <string name="welcome_feature_limits">Set daily app limits and a downtime schedule</string>
    <string name="welcome_feature_pin">Lock settings with a screen time PIN, separate from your phone\'s unlock code</string>
    <string name="welcome_feature_privacy">All data stays on this phone. This app has no internet access.</string>
    <string name="welcome_turn_on">Turn on screen time</string>
    <string name="welcome_not_now">Not now</string>

    <!-- Usage access -->
    <string name="usage_access_title">Allow usage access</string>
    <string name="usage_access_body">To show how long you use each app, Screen time needs usage access. Android asks you to turn this on in Settings.</string>
    <string name="usage_access_step_1">Tap Open settings.</string>
    <string name="usage_access_step_2">Turn on Permit usage access.</string>
    <string name="usage_access_step_3">Come back to this app. It continues on its own.</string>
    <string name="usage_access_privacy">Usage information never leaves this phone.</string>
    <string name="usage_access_open_settings">Open settings</string>

    <!-- Home -->
    <string name="home_title">Screen time and parental controls</string>
    <string name="home_tracking_off_title">Screen time is off</string>
    <string name="home_tracking_off_body">Turn it on to see how much time you spend in each app.</string>
    <string name="home_turn_on">Turn on</string>
    <string name="home_needs_access_title">Usage access is off</string>
    <string name="home_needs_access_body">Screen time can\'t see how long apps are used until you allow usage access.</string>
    <string name="home_allow_access">Allow usage access</string>
        <string name="home_use_screen_time">Use screen time</string>
    <string name="home_use_screen_time_summary">Track how long each app is used</string>

    <!-- Dashboard -->
    <string name="dashboard_today">Today</string>
    <string name="dashboard_no_usage">No app use recorded on this day.</string>
    <string name="dashboard_settings_header">Settings</string>
    <!-- Read aloud for a bar in the week chart, e.g. "Thursday, 3 hr 17 min" -->
    <string name="chart_bar_description">%1$s, %2$s</string>

    <!-- App details -->
    <string name="app_detail_daily_average">Daily average this week: %1$s</string>
    <string name="app_limit_title">App limit</string>
    <string name="app_limit_none">No limit</string>
    <string name="app_limit_coming">App limits are coming in an upcoming test build.</string>

    <!-- Usage history setting -->
    <string name="history_title">Keep usage history</string>
    <string name="history_dialog_body">Older usage is deleted from this phone.</string>
    <string name="history_one_week">1 week</string>
    <string name="history_four_weeks">4 weeks</string>
    <string name="history_three_months">3 months</string>
    <string name="history_one_year">1 year</string>

    <!-- Durations, e.g. "1 hr 5 min" -->
    <string name="duration_hours_minutes">%1$d hr %2$d min</string>
    <string name="duration_hours">%1$d hr</string>
    <string name="duration_minutes">%1$d min</string>
    <string name="duration_less_than_minute">Less than 1 min</string>

    <!-- Screen time PIN -->
    <string name="pin_setting_title">Screen time PIN</string>
    <string name="pin_setting_off">Not set. Set a PIN to lock these settings.</string>
    <string name="pin_setting_on">On. Tap to change the PIN.</string>
    <string name="pin_intro_title">Set a screen time PIN</string>
    <string name="pin_intro_body">The PIN locks screen time settings, so only someone who knows it can change them or turn screen time off.</string>
    <string name="pin_intro_not_unlock_code">This PIN is different from the code you use to unlock your phone. Choose a PIN that the person using this phone doesn\'t know.</string>
    <string name="pin_intro_forgot_warning">If you forget this PIN, the only way to remove it is to factory reset the phone, which erases all data.</string>
    <string name="pin_intro_continue">Continue</string>
    <string name="pin_enter">Enter screen time PIN</string>
    <string name="pin_enter_current">Enter current PIN</string>
    <string name="pin_choose">Choose a PIN</string>
    <!-- e.g. "4 to 6 digits"; the plural follows the larger number -->
    <plurals name="pin_length_hint">
        <item quantity="one">%1$d to %2$d digit</item>
        <item quantity="other">%1$d to %2$d digits</item>
    </plurals>
    <string name="pin_confirm">Enter the PIN again</string>
    <string name="pin_next">Next</string>
    <string name="pin_ok">OK</string>
    <string name="pin_delete">Delete</string>
    <string name="pin_wrong">Wrong PIN</string>
    <plurals name="pin_wrong_tries_left">
        <item quantity="one">Wrong PIN. %d try left before a wait.</item>
        <item quantity="other">Wrong PIN. %d tries left before a wait.</item>
    </plurals>
    <string name="pin_wait">Too many wrong attempts. Try again in %1$s</string>
    <string name="pin_mismatch">The PINs didn\'t match. Try again.</string>
    <string name="pin_not_saved">The PIN wasn\'t saved. Please start again.</string>
    <string name="pin_set">PIN set</string>
    <string name="pin_changed">PIN changed</string>
    <string name="pin_set_body">Screen time settings now need this PIN.</string>
    <string name="pin_done">Done</string>
    <plurals name="pin_digits_entered">
        <item quantity="one">%d digit entered</item>
        <item quantity="other">%d digits entered</item>
    </plurals>

    <string name="cancel">Cancel</string>
    <string name="home_privacy_note">All screen time data stays on this phone. This app has no internet access.</string>
</resources>
