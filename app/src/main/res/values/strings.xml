    <string name="restrictions_description">Each restriction needs the screen time PIN to change, or to allow it for a while.</string>
    <string name="restrictions_need_device_owner">Restrictions take effect once blocking is set up. See Settings > Blocking.</string>
    <string name="restriction_installs">App installs and uninstalls</string>
    <string name="restriction_installs_description">Includes app stores and APK files. App updates also wait while this is on.</string>
    <string name="restriction_developer">Developer options and debugging</string>
    <string name="restriction_developer_description">Includes USB and wireless debugging. Installing test builds with adb also needs this allowed.</string>
    <string name="restriction_users">Adding or switching users</string>
    <string name="restriction_users_description">Includes guest mode and new profiles.</string>
    <string name="restriction_date_time">Date, time and time zone</string>
    <string name="restriction_date_time_description">Stops changing the clock, which could otherwise shorten downtime or stretch extra time.</string>
    <string name="restriction_allow_15">Allow for 15 minutes</string>
